# ESP-IDF sdkconfig defaults
# Example: esp-idf-bytebeat / examples/console_bytebeat_dev
# Hardware-specific options must match the target board and ESP-IDF version.
# Entries and values are preserved; sections are ordered for easier review.

# ============================================================================
# ESP32-P4 Hardware Target Configuration
# ============================================================================
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# ============================================================================
# Flash Configuration (32 MB QIO Mode)
# ============================================================================
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# ============================================================================
# Partition Table
# ============================================================================
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ============================================================================
# PSRAM Configuration (Web DAW allocates render buffers in external PSRAM)
# ============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ============================================================================
# Compiler Optimization
# ============================================================================
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ============================================================================
# FreeRTOS Configuration
# ============================================================================
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n

# ============================================================================
# SPIFFS Configuration (if needed for future use)
# ============================================================================
CONFIG_SPIFFS_PAGE_SIZE=512

# ============================================================================
# Web DAW Component Configuration (Audio rendering and task scheduling)
# ============================================================================
# CONFIG_BYTEBEAT_TELEMETRY_BUFFER_SIZE=512

# ============================================================================
# Telemetry Configuration (will be added later)
# ============================================================================
# CONFIG_BYTEBEAT_TELEMETRY_ENABLE=y
# CONFIG_BYTEBEAT_TELEMETRY_QUEUE_SIZE=1024
# CONFIG_BYTEBEAT_TELEMETRY_SD_MOUNT_POINT="/sd"
CONFIG_DAW_CHUNK_SIZE=512
CONFIG_DAW_COORD_CORE_ID=1
CONFIG_DAW_I2C_SCL_GPIO=8
CONFIG_DAW_I2C_SDA_GPIO=7
CONFIG_DAW_I2S_BCLK_GPIO=12
CONFIG_DAW_I2S_DOUT_GPIO=9

# ============================================================================
# ES8311 Audio Codec Pin Configuration
# ============================================================================
CONFIG_DAW_I2S_MCLK_GPIO=13
CONFIG_DAW_I2S_WS_GPIO=10
CONFIG_DAW_JS_CORE_ID=0
CONFIG_DAW_NUM_BUFFERS=40
CONFIG_DAW_PA_PIN_GPIO=53

# ============================================================================
# Web DAW Component Configuration (Audio rendering and task scheduling)
# ============================================================================
CONFIG_DAW_SAMPLE_RATE=48000

# NVS Configuration (for settings persistence)
CONFIG_NVS_ENCRYPTION=n
CONFIG_UART_FILEBRIDGE_BACKEND_FLASH_FAT=n

# ============================================================================
# UART Filebridge Backend Configuration (Development Only!)
# ============================================================================
# Only the SD card backend is used; disable unused backends to avoid fetching
# unnecessary dependencies such as joltwallet/littlefs.
CONFIG_UART_FILEBRIDGE_BACKEND_LITTLEFS=n
CONFIG_UART_FILEBRIDGE_BACKEND_SPIFFS=n
