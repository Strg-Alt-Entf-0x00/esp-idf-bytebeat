# ESP32-P4 Rev. 1.x / 32 MB flash board profile
CONFIG_IDF_TARGET="esp32p4"

# Rev. 1.x silicon. Rev. <3 and >=3 support are mutually exclusive in ESP-IDF.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# Conservative flash settings for broad board compatibility.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# The Web DAW allocates its render buffers in external PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Audio rendering and task scheduling.
CONFIG_FREERTOS_HZ=1000
CONFIG_DAW_SAMPLE_RATE=48000
CONFIG_DAW_CHUNK_SIZE=512
CONFIG_DAW_NUM_BUFFERS=40
CONFIG_DAW_JS_CORE_ID=0
CONFIG_DAW_COORD_CORE_ID=1

# ES8311 board wiring used by this example.
CONFIG_DAW_I2S_MCLK_GPIO=13
CONFIG_DAW_I2S_BCLK_GPIO=12
CONFIG_DAW_I2S_WS_GPIO=10
CONFIG_DAW_I2S_DOUT_GPIO=9
CONFIG_DAW_I2C_SDA_GPIO=7
CONFIG_DAW_I2C_SCL_GPIO=8
CONFIG_DAW_PA_PIN_GPIO=53

# The example uses its custom 32 MB flash partition table.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
